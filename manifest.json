{
  "manifest_version": 3,
  "name": "LinkEntryGuard · 双重链接保护",
  "short_name": "LinkEntryGuard",
  "description": "对受保护 Chrome 的 HTTP/HTTPS 主页面请求前确认；Teams 网页中的普通链接点击直接禁止。",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkEntryGuard · 双重保护运行中",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "teams-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "page-click-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "confirm.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "failsafe",
        "enabled": true,
        "path": "rules/failsafe.json"
      }
    ]
  }
}
